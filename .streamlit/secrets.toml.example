# 1. Gemini API Key (from Google AI Studio: aistudio.google.com)
GEMINI_API_KEY = "your-gemini-api-key"

# 2. Email Configuration (for automated email delivery via Gmail SMTP)
SMTP_EMAIL = "your-email@gmail.com"
